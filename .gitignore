@"

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment variables
.env
.env.*
!.env.example

# Logs and caches
logs/
*.log
.cache/
coverage/

# Build output
dist/
build/

# Python
__pycache__/
*.py[cod]
venv/
.venv/

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Editor settings
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
"@ | Set-Content "$HOME\.gitignore_global"