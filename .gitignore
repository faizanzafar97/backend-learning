# Dependencies (Never commit these, they are heavy and reinstalled via npm/yarn)
node_modules/
jspm_packages/
bower_components/

# Environment variables and secrets (Crucial to protect api keys and configs)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Logs and Debug files
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports (Coredumps)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Testing and Coverage
coverage/
.nyc_output/

# Build and Output directories (If using TypeScript, Babel, or bundling)
dist/
build/
.cache/

# IDEs and Text Editors configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System Files
.DS_Store
Thumbs.db
